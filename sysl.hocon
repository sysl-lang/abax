// abax — a spreadsheet: cells holding values and formulas, recalculated in dependency order.
//
//     dependencies {
//       abax { git = "github.com/sysl-lang/abax", version = "0.1.0" }
//     }
//
// The library is `sh.sysl.abax` and needs nothing but an allocator. The application, a window with a
// menu, a formula bar and the grid, is the workspace member in `app/`, so a program taking the library
// does not take SDL with it.
package { name = "abax", version = "0.1.0", sysl = "0.8.10" }

optimization = "2"

// `heap` for the cells, the formula trees and the dependency graph.
requires {
  heap = true
}

// The formula parser runs on the Pratt loop and the token cursor.
dependencies {
  parsing { git = "github.com/sysl-lang/parsing", version = "0.13.3" }
}
