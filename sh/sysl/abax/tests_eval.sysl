module sh.sysl.abax
@tests

// What a formula shows, worked out against a sheet.
private shows(s: Sheet, f: string) -> string
    parse_formula(f) match
        Ok(e) -> evaluate(s, e).display()
        Err(m) -> "error: " + m

private calc(f: string) -> string = shows(sheet("Sheet1"), f)

// A small table: A1:A5 hold 1, "x", TRUE, nothing and 4; B1:B3 hold 10, 20, 30; C1 holds "3".
private table() -> Sheet
    var s = sheet("Sheet1")

    s.set("A1", "1").unwrap()
    s.set("A2", "x").unwrap()
    s.set("A3", "TRUE").unwrap()
    s.set("A5", "4").unwrap()
    s.set("B1", "10").unwrap()
    s.set("B2", "20").unwrap()
    s.set("B3", "30").unwrap()
    s.set("C1", "'3").unwrap()
    s
end table

// --- Operators --------------------------------------------------------------------------------------

@test("arithmetic follows Excel's precedence")
arithmetic_precedence()
    assert_eq(calc("1+2*3"), "7")
    assert_eq(calc("(1+2)*3"), "9")
    assert_eq(calc("10-4-3"), "3")
    assert_eq(calc("2*3^2"), "18")
    assert_eq(calc("-2^2"), "4")
    assert_eq(calc("0-2^2"), "-4")
    assert_eq(calc("2^3^2"), "64")
    assert_eq(calc("2^-1"), "0.5")
    assert_eq(calc("50%"), "0.5")
    assert_eq(calc("200%%"), "0.02")
    assert_eq(calc("-5%"), "-0.05")
    assert_eq(calc("1+2&3"), "33")
    assert_eq(calc("1&2+3"), "15")
    assert_eq(calc("1+1=2"), "TRUE")
    assert_eq(calc("--3"), "3")

@test("division by zero, and powers with no answer, are errors")
arithmetic_errors()
    assert_eq(calc("1/0"), "#DIV/0!")
    assert_eq(calc("0/0"), "#DIV/0!")
    assert_eq(calc("0^0"), "#NUM!")
    assert_eq(calc("0^-1"), "#DIV/0!")
    assert_eq(calc("(-8)^(1/3)"), "#NUM!")
    assert_eq(calc("1e308*10"), "#NUM!")
    assert_eq(calc("1/0+#N/A"), "#DIV/0!")
    assert_eq(calc("#N/A+1/0"), "#N/A")

@test("text that reads as a number is one to arithmetic, and other text is #VALUE!")
text_coercion()
    assert_eq(calc("\"3\"+4"), "7")
    assert_eq(calc("\" 2.5 \"*2"), "5")
    assert_eq(calc("\"50%\"*2"), "1")
    assert_eq(calc("\"abc\"+1"), "#VALUE!")
    assert_eq(calc("-\"x\""), "#VALUE!")
    assert_eq(calc("TRUE+TRUE"), "2")
    assert_eq(calc("+\"x\""), "x")
    assert_eq(calc("\"\"+1"), "#VALUE!")

@test("an empty cell is 0 to arithmetic and empty text to &, and a formula naming one shows 0")
empty_cells()
    assert_eq(calc("A1"), "0")
    assert_eq(calc("A1+1"), "1")
    assert_eq(calc("A1&\"x\""), "x")
    assert_eq(calc("A1=0"), "TRUE")
    assert_eq(calc("A1=\"\""), "TRUE")
    assert_eq(calc("A1=FALSE"), "TRUE")

@test("& joins text, writing numbers with fifteen digits")
concatenation()
    assert_eq(calc("\"a\"&\"b\""), "ab")
    assert_eq(calc("1/3&\"\""), "0.333333333333333")
    assert_eq(calc("TRUE&1"), "TRUE1")
    assert_eq(calc("\"x\"&#REF!"), "#REF!")

@test("comparison orders numbers before text before logicals, and ignores case")
comparison()
    assert_eq(calc("1<2"), "TRUE")
    assert_eq(calc("2<=2"), "TRUE")
    assert_eq(calc("3>=4"), "FALSE")
    assert_eq(calc("1<>1"), "FALSE")
    assert_eq(calc("\"a\"=\"A\""), "TRUE")
    assert_eq(calc("\"apple\"<\"Banana\""), "TRUE")
    assert_eq(calc("1<\"0\""), "TRUE")
    assert_eq(calc("\"z\"<TRUE"), "TRUE")
    assert_eq(calc("FALSE<TRUE"), "TRUE")
    assert_eq(calc("1=TRUE"), "FALSE")
    assert_eq(calc("#N/A=1"), "#N/A")

@test("a name nobody defined, and a function nobody wrote, are #NAME?")
unknown_names()
    assert_eq(calc("foo"), "#NAME?")
    assert_eq(calc("foo+1"), "#NAME?")
    assert_eq(calc("NOSUCH(1)"), "#NAME?")
    assert_eq(calc("ISERROR(NOSUCH(1))"), "TRUE")

@test("a range where one value is wanted is #VALUE!, unless it is one cell")
range_as_value()
    val s = table()

    assert_eq(shows(s, "A1:A2+1"), "#VALUE!")
    assert_eq(shows(s, "B1:B1+1"), "11")

@test("a reference to another sheet is #REF! while a sheet holds one sheet")
other_sheets()
    val s = table()

    assert_eq(shows(s, "Sheet2!A1"), "#REF!")
    assert_eq(shows(s, "SUM(Sheet2!A1:A3)"), "#REF!")
    assert_eq(shows(s, "Sheet1!B1"), "10")
    assert_eq(shows(s, "sheet1!B1+'Sheet1'!B2"), "30")

// --- Aggregates -------------------------------------------------------------------------------------

@test("SUM skips text, logicals and blanks in a range, and reads an argument typed directly")
sum_rules()
    val s = table()

    assert_eq(shows(s, "SUM(A1:A5)"), "5")
    assert_eq(shows(s, "SUM(A1:B3)"), "61")
    assert_eq(shows(s, "SUM(1,TRUE,\"3\")"), "5")
    assert_eq(shows(s, "SUM(A3)"), "0")
    assert_eq(shows(s, "SUM(A3,TRUE)"), "1")
    // A cell holding text that looks like a number is still text in a range.
    assert_eq(shows(s, "SUM(C1)"), "0")
    assert_eq(shows(s, "SUM(C1,\"3\")"), "3")
    assert_eq(shows(s, "SUM(\"x\")"), "#VALUE!")
    assert_eq(shows(s, "SUM(A:A)"), "5")
    assert_eq(shows(s, "SUM(1:1)"), "11")
    assert_eq(shows(s, "SUM(D1:D9)"), "0")
    assert_eq(shows(s, "SUM(1,,2)"), "3")

@test("an error in a range is the answer of the function that reads it")
errors_in_ranges()
    var s = table()

    s.set("B4", "=1/0").unwrap()
    assert_eq(shows(s, "SUM(B1:B4)"), "#DIV/0!")
    assert_eq(shows(s, "MAX(B:B)"), "#DIV/0!")
    assert_eq(shows(s, "COUNT(B1:B4)"), "3")
    assert_eq(shows(s, "COUNTA(B1:B4)"), "4")
    assert_eq(shows(s, "SUM(#N/A)"), "#N/A")

@test("AVERAGE, MIN, MAX and PRODUCT, and what each makes of nothing")
statistics()
    val s = table()

    assert_eq(shows(s, "AVERAGE(B1:B3)"), "20")
    assert_eq(shows(s, "AVERAGE(A1:A5)"), "2.5")
    assert_eq(shows(s, "MIN(B1:B3,5)"), "5")
    assert_eq(shows(s, "MAX(B1:B3,5)"), "30")
    assert_eq(shows(s, "MIN(-1,-7)"), "-7")
    assert_eq(shows(s, "PRODUCT(B1:B3)"), "6000")
    assert_eq(shows(s, "PRODUCT(2,\"3\")"), "6")
    assert_eq(shows(s, "AVERAGE(D1:D3)"), "#DIV/0!")
    assert_eq(shows(s, "MIN(D1:D3)"), "0")
    assert_eq(shows(s, "MAX(A2)"), "0")
    assert_eq(shows(s, "PRODUCT(D1)"), "0")
    assert_eq(shows(s, "SUM()"), "#VALUE!")

@test("COUNT counts numbers, COUNTA everything there, COUNTBLANK what is empty")
counting()
    val s = table()

    assert_eq(shows(s, "COUNT(A1:A5)"), "2")
    assert_eq(shows(s, "COUNT(1,\"2\",\"x\",TRUE)"), "3")
    assert_eq(shows(s, "COUNTA(A1:A5)"), "4")
    assert_eq(shows(s, "COUNTA(1,\"x\")"), "2")
    assert_eq(shows(s, "COUNTBLANK(A1:A5)"), "1")
    assert_eq(shows(s, "COUNTBLANK(D1:E2)"), "4")
    assert_eq(shows(s, "COUNTBLANK(A:A)"), "1048572")
    assert_eq(shows(s, "COUNTBLANK(1)"), "#VALUE!")
    assert_eq(shows(s, "COUNT(A:A)"), "2")

@test("COUNTBLANK counts empty text as blank, as Excel does")
countblank_empty_text()
    var s = sheet("Sheet1")

    s.set("A1", "=\"\"").unwrap()
    s.set("A2", "x").unwrap()
    assert_eq(shows(s, "COUNTBLANK(A1:A3)"), "2")
    assert_eq(shows(s, "COUNTA(A1:A3)"), "2")

// --- Mathematics ------------------------------------------------------------------------------------

@test("ABS, INT, SQRT, MOD, POWER and PI")
mathematics()
    assert_eq(calc("ABS(-3)"), "3")
    assert_eq(calc("INT(2.7)"), "2")
    assert_eq(calc("INT(-2.3)"), "-3")
    assert_eq(calc("SQRT(16)"), "4")
    assert_eq(calc("SQRT(-1)"), "#NUM!")
    assert_eq(calc("MOD(7,3)"), "1")
    assert_eq(calc("MOD(-3,2)"), "1")
    assert_eq(calc("MOD(3,-2)"), "-1")
    assert_eq(calc("MOD(1,0)"), "#DIV/0!")
    assert_eq(calc("POWER(2,10)"), "1024")
    assert_eq(calc("POWER(0,0)"), "#NUM!")
    assert_eq(calc("PI()"), "3.141592654")
    assert_eq(calc("PI(1)"), "#VALUE!")
    assert_eq(calc("ABS(\"x\")"), "#VALUE!")
    assert_eq(calc("ABS()"), "#VALUE!")

@test("ROUND goes half away from zero at the digits typed, ROUNDUP away and ROUNDDOWN toward")
rounding()
    assert_eq(calc("ROUND(2.5,0)"), "3")
    assert_eq(calc("ROUND(-2.5,0)"), "-3")
    assert_eq(calc("ROUND(2.675,2)"), "2.68")
    assert_eq(calc("ROUND(1.005,2)"), "1.01")
    assert_eq(calc("ROUND(1234.5678,-2)"), "1200")
    assert_eq(calc("ROUND(3.14159,3)"), "3.142")
    assert_eq(calc("ROUND(5,1.9)"), "5")
    assert_eq(calc("ROUNDUP(3.2,0)"), "4")
    assert_eq(calc("ROUNDUP(-3.2,0)"), "-4")
    assert_eq(calc("ROUNDUP(31415.92654,-2)"), "31500")
    assert_eq(calc("ROUNDDOWN(3.9,0)"), "3")
    assert_eq(calc("ROUNDDOWN(-3.9,0)"), "-3")
    assert_eq(calc("ROUNDDOWN(0.29,1)"), "0.2")
    assert_eq(calc("ROUND(\"x\",1)"), "#VALUE!")

// --- Logic ------------------------------------------------------------------------------------------

@test("IF evaluates only the branch it takes")
lazy_if()
    assert_eq(calc("IF(TRUE,1,1/0)"), "1")
    assert_eq(calc("IF(FALSE,1/0,2)"), "2")
    assert_eq(calc("IF(1>2,\"big\")"), "FALSE")
    assert_eq(calc("IF(TRUE,,2)"), "0")
    assert_eq(calc("IF(\"x\",1,2)"), "#VALUE!")
    assert_eq(calc("IF(#N/A,1,2)"), "#N/A")
    assert_eq(calc("IF(0,1,2)"), "2")
    assert_eq(calc("IF(\"true\",1,2)"), "1")
    assert_eq(calc("IF()"), "#VALUE!")

@test("IFERROR gives its second argument for any error, and only then evaluates it")
iferror()
    assert_eq(calc("IFERROR(1/0,\"none\")"), "none")
    assert_eq(calc("IFERROR(5,1/0)"), "5")
    assert_eq(calc("IFERROR(NOSUCH(),7)"), "7")
    assert_eq(calc("IFERROR(#N/A,#REF!)"), "#REF!")

@test("AND, OR and NOT, with ranges skipping text")
logic()
    val s = table()

    assert_eq(calc("AND(TRUE,1)"), "TRUE")
    assert_eq(calc("AND(TRUE,0)"), "FALSE")
    assert_eq(calc("OR(FALSE,0)"), "FALSE")
    assert_eq(calc("OR(FALSE,2)"), "TRUE")
    assert_eq(calc("NOT(TRUE)"), "FALSE")
    assert_eq(calc("NOT(0)"), "TRUE")
    assert_eq(shows(s, "AND(A1:A5)"), "TRUE")
    assert_eq(shows(s, "AND(A2)"), "#VALUE!")
    assert_eq(calc("AND(\"x\")"), "#VALUE!")
    assert_eq(calc("OR(1/0,TRUE)"), "#DIV/0!")
    assert_eq(calc("NOT(\"x\")"), "#VALUE!")

@test("ISBLANK, ISNUMBER, ISTEXT and ISERROR ask what kind a value is")
kinds()
    val s = table()

    assert_eq(shows(s, "ISBLANK(A4)"), "TRUE")
    assert_eq(shows(s, "ISBLANK(A1)"), "FALSE")
    assert_eq(shows(s, "ISBLANK(\"\")"), "FALSE")
    assert_eq(shows(s, "ISNUMBER(A1)"), "TRUE")
    assert_eq(shows(s, "ISNUMBER(C1)"), "FALSE")
    assert_eq(shows(s, "ISNUMBER(\"3\")"), "FALSE")
    assert_eq(shows(s, "ISTEXT(A2)"), "TRUE")
    assert_eq(shows(s, "ISTEXT(A3)"), "FALSE")
    assert_eq(shows(s, "ISERROR(1/0)"), "TRUE")
    assert_eq(shows(s, "ISERROR(1)"), "FALSE")
    assert_eq(shows(s, "ISERROR(A1:A2)"), "TRUE")

// --- Text -------------------------------------------------------------------------------------------

@test("CONCATENATE and CONCAT join their arguments, a range's cells in order")
concat_functions()
    val s = table()

    assert_eq(shows(s, "CONCATENATE(\"a\",1,TRUE)"), "a1TRUE")
    assert_eq(shows(s, "CONCAT(B1:B3)"), "102030")
    assert_eq(shows(s, "CONCAT(A1:A3,\"!\")"), "1xTRUE!")
    assert_eq(shows(s, "CONCAT(\"a\",1/0)"), "#DIV/0!")

@test("LEN, UPPER, LOWER and TRIM count and change characters, not bytes")
text_functions()
    assert_eq(calc("LEN(\"héllo\")"), "5")
    assert_eq(calc("LEN(\"\")"), "0")
    assert_eq(calc("LEN(12.5)"), "4")
    assert_eq(calc("UPPER(\"abc\")"), "ABC")
    assert_eq(calc("LOWER(\"ABC\")"), "abc")
    assert_eq(calc("TRIM(\"  a   b  \")"), "a b")
    assert_eq(calc("TRIM(\"   \")"), "")
    assert_eq(calc("LEN(1/0)"), "#DIV/0!")

@test("LEFT, RIGHT and MID take characters, clipping at the ends")
substrings()
    assert_eq(calc("LEFT(\"héllo\",2)"), "hé")
    assert_eq(calc("LEFT(\"abc\")"), "a")
    assert_eq(calc("LEFT(\"abc\",10)"), "abc")
    assert_eq(calc("LEFT(\"abc\",0)"), "")
    assert_eq(calc("RIGHT(\"héllo\",4)"), "éllo")
    assert_eq(calc("RIGHT(\"abc\",5)"), "abc")
    assert_eq(calc("MID(\"héllo\",2,3)"), "éll")
    assert_eq(calc("MID(\"abc\",3,10)"), "c")
    assert_eq(calc("MID(\"abc\",5,1)"), "")
    assert_eq(calc("MID(\"abc\",0,1)"), "#VALUE!")
    assert_eq(calc("LEFT(\"abc\",-1)"), "#VALUE!")
    assert_eq(calc("MID(\"abc\",1,-1)"), "#VALUE!")
    assert_eq(calc("MID(\"abc\",1)"), "#VALUE!")

// --- Lookups ----------------------------------------------------------------------------------------

// A price list: A1:A4 keys ascending, B1:B4 names, C1:C4 prices.
private prices() -> Sheet
    var s = sheet("Sheet1")

    s.set("A1", "10").unwrap()
    s.set("A2", "20").unwrap()
    s.set("A3", "30").unwrap()
    s.set("A4", "40").unwrap()
    s.set("B1", "apple").unwrap()
    s.set("B2", "Banana").unwrap()
    s.set("B3", "cherry").unwrap()
    s.set("B4", "date").unwrap()
    s.set("C1", "1.5").unwrap()
    s.set("C2", "0.25").unwrap()
    s.set("C3", "3").unwrap()
    s.set("C4", "2").unwrap()
    s
end prices

@test("VLOOKUP finds a key exactly or by the last one not above it")
vlookup()
    val s = prices()

    assert_eq(shows(s, "VLOOKUP(30,A1:C4,2,FALSE)"), "cherry")
    assert_eq(shows(s, "VLOOKUP(25,A1:C4,3)"), "0.25")
    assert_eq(shows(s, "VLOOKUP(25,A1:C4,3,TRUE)"), "0.25")
    assert_eq(shows(s, "VLOOKUP(99,A1:C4,2)"), "date")
    assert_eq(shows(s, "VLOOKUP(5,A1:C4,2)"), "#N/A")
    assert_eq(shows(s, "VLOOKUP(25,A1:C4,2,FALSE)"), "#N/A")
    assert_eq(shows(s, "VLOOKUP(\"BANANA\",B1:C4,2,FALSE)"), "0.25")
    assert_eq(shows(s, "VLOOKUP(\"20\",A1:C4,2,FALSE)"), "#N/A")
    assert_eq(shows(s, "VLOOKUP(10,A1:C4,4)"), "#REF!")
    assert_eq(shows(s, "VLOOKUP(10,A1:C4,0)"), "#VALUE!")
    assert_eq(shows(s, "VLOOKUP(10,5,1)"), "#VALUE!")
    assert_eq(shows(s, "VLOOKUP(1/0,A1:C4,1)"), "#DIV/0!")
    assert_eq(shows(s, "VLOOKUP(40,A:C,3,FALSE)"), "2")

@test("HLOOKUP finds a key along the first row")
hlookup()
    var s = sheet("Sheet1")

    s.set("A1", "1").unwrap()
    s.set("B1", "2").unwrap()
    s.set("C1", "3").unwrap()
    s.set("A2", "one").unwrap()
    s.set("B2", "two").unwrap()
    s.set("C2", "three").unwrap()
    assert_eq(shows(s, "HLOOKUP(2,A1:C2,2,FALSE)"), "two")
    assert_eq(shows(s, "HLOOKUP(2.5,A1:C2,2)"), "two")
    assert_eq(shows(s, "HLOOKUP(0,A1:C2,2)"), "#N/A")
    assert_eq(shows(s, "HLOOKUP(1,A1:C2,3)"), "#REF!")
    assert_eq(shows(s, "HLOOKUP(3,1:2,2,FALSE)"), "three")

@test("INDEX reads a position counted from one")
index_function()
    val s = prices()

    assert_eq(shows(s, "INDEX(A1:C4,2,2)"), "Banana")
    assert_eq(shows(s, "INDEX(B1:B4,3)"), "cherry")
    assert_eq(shows(s, "INDEX(A1:C1,3)"), "1.5")
    assert_eq(shows(s, "INDEX(A1:C4,5,1)"), "#REF!")
    assert_eq(shows(s, "INDEX(A1:C4,1,4)"), "#REF!")
    assert_eq(shows(s, "INDEX(A1:C4,0,1)"), "#VALUE!")
    assert_eq(shows(s, "INDEX(A:A,4)"), "40")
    assert_eq(shows(s, "INDEX(A1:C4,4,4-1)"), "2")
    // An empty cell inside the range answers as one, which a formula shows as 0.
    assert_eq(shows(s, "INDEX(A1:D4,1,4)"), "0")

@test("MATCH finds a position exactly, ascending or descending")
match_function()
    var s = prices()

    assert_eq(shows(s, "MATCH(30,A1:A4,0)"), "3")
    assert_eq(shows(s, "MATCH(35,A1:A4)"), "3")
    assert_eq(shows(s, "MATCH(35,A1:A4,1)"), "3")
    assert_eq(shows(s, "MATCH(5,A1:A4)"), "#N/A")
    assert_eq(shows(s, "MATCH(\"CHERRY\",B1:B4,0)"), "3")
    assert_eq(shows(s, "MATCH(31,A1:A4,0)"), "#N/A")
    assert_eq(shows(s, "MATCH(1,A1:C4,0)"), "#N/A")
    assert_eq(shows(s, "MATCH(\"apple\",A1:C1,0)"), "2")
    assert_eq(shows(s, "MATCH(40,A:A,0)"), "4")

    s.set("D1", "9").unwrap()
    s.set("D2", "7").unwrap()
    s.set("D3", "5").unwrap()
    assert_eq(shows(s, "MATCH(6,D1:D3,-1)"), "2")
    assert_eq(shows(s, "MATCH(10,D1:D3,-1)"), "#N/A")
    assert_eq(shows(s, "MATCH(5,D1:D3,-1)"), "3")

@test("a lookup's index can be worked out by another lookup")
nested_lookups()
    val s = prices()

    assert_eq(shows(s, "INDEX(C1:C4,MATCH(\"date\",B1:B4,0))"), "2")
    assert_eq(shows(s, "VLOOKUP(INDEX(A1:A4,2),A1:C4,2,FALSE)"), "Banana")
