@test("LibreOffice agrees with abax: text")
oracle_text()
    val s = oracle_sheet()

    assert_eq(differs(s, "J143", Number(6.0)), "")
    assert_eq(differs(s, "J144", Number(15.0)), "")
    assert_eq(differs(s, "J145", Number(6.0)), "")
    assert_eq(differs(s, "J146", Number(0.0)), "")
    assert_eq(differs(s, "J147", Text("app")), "")
    assert_eq(differs(s, "J148", Text("a")), "")
    assert_eq(differs(s, "J149", Text("apple")), "")
    assert_eq(differs(s, "J150", Error(fault_named("#VALUE!").unwrap())), "")
    assert_eq(differs(s, "J151", Text("na")), "")
    assert_eq(differs(s, "J152", Text("")), "")
    assert_eq(differs(s, "J153", Text("her")), "")
    assert_eq(differs(s, "J154", Text("")), "")
    assert_eq(differs(s, "J155", Error(fault_named("#VALUE!").unwrap())), "")
    assert_eq(differs(s, "J156", Text("APPLE")), "")
    assert_eq(differs(s, "J157", Text("hello world")), "")
    assert_eq(differs(s, "J158", Text("padded text")), "")
    assert_eq(differs(s, "J159", Text("apple banana")), "")
    // =CONCATENATE(1,TRUE): LibreOffice gives '11; Excel's TRUE joins as the word; Excel's logicals are a kind of their own; LibreOffice's TRUE is the number 1
    assert_eq(differs(s, "J160", Text("1TRUE")), "")
    assert_eq(differs(s, "J161", Text("applebananacherry")), "")
    // =CONCAT(A1,A3,1.5): LibreOffice gives '111.5; Excel's TRUE joins as the word; Excel's logicals are a kind of their own; LibreOffice's TRUE is the number 1
    assert_eq(differs(s, "J162", Text("1TRUE1.5")), "")
    assert_eq(differs(s, "J163", Text("0.25")), "")

@test("LibreOffice agrees with abax: lookups")
oracle_lookups()
    val s = oracle_sheet()

    assert_eq(differs(s, "J164", Text("three")), "")
    assert_eq(differs(s, "J165", Number(300.0)), "")
    assert_eq(differs(s, "J166", Text("two")), "")
    assert_eq(differs(s, "J167", Error(fault_named("#N/A").unwrap())), "")
    assert_eq(differs(s, "J168", Error(fault_named("#N/A").unwrap())), "")
    // =VLOOKUP(3,F1:H5,4): LibreOffice gives #VALUE!; Excel documents #REF! for a column past the table's last
    assert_eq(differs(s, "J169", Error(fault_named("#REF!").unwrap())), "")
    assert_eq(differs(s, "J170", Number(300.0)), "")
    assert_eq(differs(s, "J171", Number(300.0)), "")
    assert_eq(differs(s, "J172", Text("c")), "")
    assert_eq(differs(s, "J173", Text("c")), "")
    assert_eq(differs(s, "J174", Error(fault_named("#N/A").unwrap())), "")
    assert_eq(differs(s, "J175", Number(200.0)), "")
    assert_eq(differs(s, "J176", Number(4.0)), "")
    assert_eq(differs(s, "J177", Error(fault_named("#REF!").unwrap())), "")
    assert_eq(differs(s, "J178", Number(30.0)), "")
    assert_eq(differs(s, "J179", Number(4.0)), "")
    assert_eq(differs(s, "J180", Number(4.0)), "")
    assert_eq(differs(s, "J181", Number(3.0)), "")
    assert_eq(differs(s, "J182", Error(fault_named("#N/A").unwrap())), "")
    assert_eq(differs(s, "J183", Number(3.0)), "")
    assert_eq(differs(s, "J184", Number(5.0)), "")

@test("LibreOffice agrees with abax: errors and names")
oracle_errors_and_names()
    val s = oracle_sheet()

    assert_eq(differs(s, "J185", Error(fault_named("#NAME?").unwrap())), "")
    assert_eq(differs(s, "J186", Error(fault_named("#NAME?").unwrap())), "")
    assert_eq(differs(s, "J187", Error(fault_named("#N/A").unwrap())), "")
    // =#REF!: LibreOffice gives #NAME?; LibreOffice reads a formula that is only #REF! as an unknown name
    assert_eq(differs(s, "J188", Error(fault_named("#REF!").unwrap())), "")
    // =ISERROR(FOO(1)): LibreOffice gives #VALUE!; an unknown function inside a call is a syntax error (Err:509) to LibreOffice
    assert_eq(differs(s, "J189", Bool(true)), "")
