// "" when the cell's value is `want` (a number to within one part in 10^12), else what differs.
private differs(s: Sheet, addr: string, want: Value) -> string
    val got = s.value(addr)
    val same = want match
        Number(x) ->
            got match
                Number(y) -> (x - y).abs() <= 1e-12 * x.abs().max(y.abs())
                _ -> false
        _ -> got == want

    if same then "" else s"${addr} ${s.input(addr)}: abax ${got.display()}, LibreOffice ${want.display()}"
end differs

@test("LibreOffice agrees with abax: operators and precedence")
oracle_operators_and_precedence()
    val s = oracle_sheet()

    assert_eq(differs(s, "J1", Number(7.0)), "")
    assert_eq(differs(s, "J2", Number(9.0)), "")
    assert_eq(differs(s, "J3", Number(3.0)), "")
    assert_eq(differs(s, "J4", Number(18.0)), "")
    assert_eq(differs(s, "J5", Number(4.0)), "")
    assert_eq(differs(s, "J6", Number(-4.0)), "")
    assert_eq(differs(s, "J7", Number(64.0)), "")
    assert_eq(differs(s, "J8", Number(0.5)), "")
    assert_eq(differs(s, "J9", Number(0.5)), "")
    assert_eq(differs(s, "J10", Number(0.02)), "")
    assert_eq(differs(s, "J11", Number(5.0)), "")
    assert_eq(differs(s, "J12", Number(2.5)), "")
    assert_eq(differs(s, "J13", Error(fault_named("#DIV/0!").unwrap())), "")
    assert_eq(differs(s, "J14", Error(fault_named("#DIV/0!").unwrap())), "")
    assert_eq(differs(s, "J15", Text("78")), "")
    assert_eq(differs(s, "J16", Text("ab1.5")), "")
    assert_eq(differs(s, "J17", Bool(true)), "")
    assert_eq(differs(s, "J18", Bool(false)), "")
    assert_eq(differs(s, "J19", Bool(true)), "")
    assert_eq(differs(s, "J20", Bool(true)), "")
    assert_eq(differs(s, "J21", Bool(true)), "")
    assert_eq(differs(s, "J22", Bool(true)), "")
    assert_eq(differs(s, "J23", Bool(true)), "")
    // =TRUE>1: LibreOffice gives FALSE; Excel orders every logical after every number; Excel's logicals are a kind of their own; LibreOffice's TRUE is the number 1
    assert_eq(differs(s, "J24", Bool(true)), "")
    assert_eq(differs(s, "J25", Bool(false)), "")
    assert_eq(differs(s, "J26", Bool(true)), "")
    assert_eq(differs(s, "J27", Bool(false)), "")
    assert_eq(differs(s, "J28", Number(-1.0)), "")
    assert_eq(differs(s, "J29", Number(4.0)), "")
    assert_eq(differs(s, "J30", Number(-2.0)), "")
    assert_eq(differs(s, "J31", Number(0.333333333333333)), "")
    assert_eq(differs(s, "J32", Number(1.4142135623731)), "")
    assert_eq(differs(s, "J33", Number(0.1)), "")
    assert_eq(differs(s, "J34", Number(1e+20)), "")
    assert_eq(differs(s, "J35", Error(fault_named("#NUM!").unwrap())), "")
    // =(-8)^(1/3): LibreOffice gives -2; Excel refuses a negative number to a fractional power; LibreOffice takes the odd root
    assert_eq(differs(s, "J36", Error(fault_named("#NUM!").unwrap())), "")
    // =0^0: LibreOffice gives 1; Excel documents #NUM! for 0^0
    assert_eq(differs(s, "J37", Error(fault_named("#NUM!").unwrap())), "")
    assert_eq(differs(s, "J38", Number(4.0)), "")
    assert_eq(differs(s, "J39", Error(fault_named("#NUM!").unwrap())), "")
    assert_eq(differs(s, "J40", Number(-0.0)), "")

@test("LibreOffice agrees with abax: coercion")
oracle_coercion()
    val s = oracle_sheet()

    assert_eq(differs(s, "J41", Number(5.0)), "")
    assert_eq(differs(s, "J42", Error(fault_named("#VALUE!").unwrap())), "")
    assert_eq(differs(s, "J43", Number(2.0)), "")
    assert_eq(differs(s, "J44", Number(1.0)), "")
    assert_eq(differs(s, "J45", Text("1")), "")
    assert_eq(differs(s, "J46", Error(fault_named("#DIV/0!").unwrap())), "")
    assert_eq(differs(s, "J47", Number(0.3)), "")
    assert_eq(differs(s, "J48", Bool(true)), "")
    assert_eq(differs(s, "J49", Number(4.0)), "")
    assert_eq(differs(s, "J50", Error(fault_named("#VALUE!").unwrap())), "")
    assert_eq(differs(s, "J51", Number(4.0)), "")
    assert_eq(differs(s, "J52", Bool(true)), "")
    assert_eq(differs(s, "J53", Bool(true)), "")
    assert_eq(differs(s, "J54", Bool(true)), "")
    assert_eq(differs(s, "J55", Number(2.0)), "")
    // =A3&"": LibreOffice gives '1; Excel's TRUE joins as the word; Excel's logicals are a kind of their own; LibreOffice's TRUE is the number 1
    assert_eq(differs(s, "J56", Text("TRUE")), "")
    // ="x"&TRUE: LibreOffice gives x1; Excel's TRUE joins as the word; Excel's logicals are a kind of their own; LibreOffice's TRUE is the number 1
    assert_eq(differs(s, "J57", Text("xTRUE")), "")
    assert_eq(differs(s, "J58", Text("1")), "")
    assert_eq(differs(s, "J59", Text("0.3")), "")
    assert_eq(differs(s, "J60", Text("0.333333333333333")), "")
    // =1E+20&"": LibreOffice gives '1E+020; Excel writes a two-digit exponent; LibreOffice writes three
    assert_eq(differs(s, "J61", Text("1E+20")), "")
    assert_eq(differs(s, "J62", Error(fault_named("#DIV/0!").unwrap())), "")
    // =#N/A+1/0: LibreOffice gives #DIV/0!; Excel answers the first error from the left; LibreOffice the right operand's
    assert_eq(differs(s, "J63", Error(fault_named("#N/A").unwrap())), "")
    assert_eq(differs(s, "J64", Error(fault_named("#DIV/0!").unwrap())), "")

@test("LibreOffice agrees with abax: aggregates")
oracle_aggregates()
    val s = oracle_sheet()

    assert_eq(differs(s, "J65", Number(150.0)), "")
    // =SUM(A1:A7): LibreOffice gives 3.5; Excel's aggregates skip a logical in a range, as they skip text; LibreOffice counts A3's TRUE as 1
    assert_eq(differs(s, "J66", Number(2.5)), "")
    assert_eq(differs(s, "J67", Error(fault_named("#DIV/0!").unwrap())), "")
    // =SUM(1,"2",TRUE): LibreOffice gives #VALUE!; Excel reads text typed as an argument as a number; LibreOffice's default refuses to convert text
    assert_eq(differs(s, "J68", Number(4.0)), "")
    assert_eq(differs(s, "J69", Number(250.0)), "")
    assert_eq(differs(s, "J70", Number(170.0)), "")
    assert_eq(differs(s, "J71", Number(1.0)), "")
    assert_eq(differs(s, "J72", Number(10.0)), "")
    assert_eq(differs(s, "J73", Error(fault_named("#VALUE!").unwrap())), "")
    assert_eq(differs(s, "J74", Number(6000.0)), "")
    // =PRODUCT(A2:A4): LibreOffice gives 1; Excel's aggregates skip a logical in a range, as they skip text; LibreOffice counts A3's TRUE as 1, and Excel's PRODUCT of no numbers is 0
    assert_eq(differs(s, "J75", Number(0.0)), "")
    assert_eq(differs(s, "J76", Number(30.0)), "")
    // =AVERAGE(A1:A7): LibreOffice gives 0.875; Excel's aggregates skip a logical in a range, as they skip text; LibreOffice counts A3's TRUE as 1
    assert_eq(differs(s, "J77", Number(0.8333333333333334)), "")
    // =AVERAGE(A2:A4): LibreOffice gives 1; Excel's aggregates skip a logical in a range, as they skip text; LibreOffice counts A3's TRUE as 1, and an AVERAGE of no numbers is #DIV/0!
    assert_eq(differs(s, "J78", Error(fault_named("#DIV/0!").unwrap())), "")
    assert_eq(differs(s, "J79", Number(5.0)), "")
    assert_eq(differs(s, "J80", Number(50.0)), "")
    assert_eq(differs(s, "J81", Number(0.0)), "")
    assert_eq(differs(s, "J82", Number(4.0)), "")
    // =COUNT(A1:A8): LibreOffice gives 4; Excel's aggregates skip a logical in a range, as they skip text; LibreOffice counts A3's TRUE as 1
    assert_eq(differs(s, "J83", Number(3.0)), "")
    assert_eq(differs(s, "J84", Number(7.0)), "")
    assert_eq(differs(s, "J85", Number(1.0)), "")
    assert_eq(differs(s, "J86", Number(3.0)), "")
    assert_eq(differs(s, "J87", Number(3.0)), "")
    assert_eq(differs(s, "J88", Number(6.0)), "")
    assert_eq(differs(s, "J89", Number(6.0)), "")

@test("LibreOffice agrees with abax: arithmetic functions")
oracle_arithmetic_functions()
    val s = oracle_sheet()

    assert_eq(differs(s, "J90", Number(2.5)), "")
    assert_eq(differs(s, "J91", Number(3.0)), "")
    assert_eq(differs(s, "J92", Number(-3.0)), "")
    assert_eq(differs(s, "J93", Number(2.0)), "")
    assert_eq(differs(s, "J94", Number(1.0)), "")
    assert_eq(differs(s, "J95", Number(2.0)), "")
    assert_eq(differs(s, "J96", Number(-2.0)), "")
    assert_eq(differs(s, "J97", Number(1.5)), "")
    assert_eq(differs(s, "J98", Error(fault_named("#DIV/0!").unwrap())), "")
    assert_eq(differs(s, "J99", Number(1024.0)), "")
    // =POWER(0,-1): LibreOffice gives #NUM!; Excel documents #DIV/0! for zero to a negative power
    assert_eq(differs(s, "J100", Error(fault_named("#DIV/0!").unwrap())), "")
    assert_eq(differs(s, "J101", Number(4.0)), "")
    // =SQRT(-1): LibreOffice gives #VALUE!; Excel documents #NUM!; LibreOffice's own Err:502 is cached as #VALUE!
    assert_eq(differs(s, "J102", Error(fault_named("#NUM!").unwrap())), "")
    assert_eq(differs(s, "J103", Number(3.14159265358979)), "")
    assert_eq(differs(s, "J104", Number(6.28318530717959)), "")
    assert_eq(differs(s, "J105", Number(2.35)), "")
    assert_eq(differs(s, "J106", Number(-3.0)), "")
    assert_eq(differs(s, "J107", Number(3.0)), "")
    assert_eq(differs(s, "J108", Number(1200.0)), "")
    assert_eq(differs(s, "J109", Number(0.29)), "")
    assert_eq(differs(s, "J110", Number(1.01)), "")
    assert_eq(differs(s, "J111", Number(2.35)), "")
    assert_eq(differs(s, "J112", Number(-3.0)), "")
    assert_eq(differs(s, "J113", Number(-2.34)), "")
    assert_eq(differs(s, "J114", Number(1000.0)), "")

@test("LibreOffice agrees with abax: logic")
oracle_logic()
    val s = oracle_sheet()

    assert_eq(differs(s, "J115", Text("pos")), "")
    assert_eq(differs(s, "J116", Error(fault_named("#VALUE!").unwrap())), "")
    assert_eq(differs(s, "J117", Bool(false)), "")
    assert_eq(differs(s, "J118", Number(0.0)), "")
    assert_eq(differs(s, "J119", Number(2.0)), "")
    assert_eq(differs(s, "J120", Number(1.0)), "")
    assert_eq(differs(s, "J121", Text("oops")), "")
    assert_eq(differs(s, "J122", Number(5.0)), "")
    assert_eq(differs(s, "J123", Text("x")), "")
    assert_eq(differs(s, "J124", Bool(true)), "")
    assert_eq(differs(s, "J125", Bool(true)), "")
    assert_eq(differs(s, "J126", Bool(false)), "")
    assert_eq(differs(s, "J127", Bool(false)), "")
    assert_eq(differs(s, "J128", Bool(true)), "")
    assert_eq(differs(s, "J129", Error(fault_named("#VALUE!").unwrap())), "")
    assert_eq(differs(s, "J130", Bool(false)), "")
    assert_eq(differs(s, "J131", Bool(true)), "")
    assert_eq(differs(s, "J132", Error(fault_named("#VALUE!").unwrap())), "")

@test("LibreOffice agrees with abax: information")
oracle_information()
