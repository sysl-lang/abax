// What the window is showing, with no window: the sheet, which cell is active and what is selected,
// where the grid is scrolled to, how wide each column is, and the cell being typed into. Every key and
// click the grid receives lands here as a call, so all of it is tested without SDL.

import sh.sysl.abax.{Sheet, Value, Area, Ref, Clip, sheet, at, area_of, column_name, parse_area, general,
                     col_of, row_of, MAX_COLS, MAX_ROWS}
import sh.sysl.ui.{Signal, signal, Press, Key, Selection, apply}
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}
import sysl.text.{split, Search}

// The height of a row and the width a column starts at, in points.
const ROW_H: int = 22
const COL_W: int = 80

// The narrowest a column may be dragged to.
const MIN_COL_W: int = 12

struct Model
    sheet: Sheet

    // The active cell, and the far corner of the selection. A selection always contains the active
    // cell; it is one cell when the two agree.
    col: int
    row: int
    far_col: int
    far_row: int

    // The first column and row on screen.
    left: int
    top: int

    // The room the cells had at the last paint, which is what "follow the active cell" and a page
    // are measured against.
    room_w: int
    room_h: int

    // What the last copy or cut took, the text it put on the system clipboard, and the area drawn
    // with a dashed outline until a paste of a cut, an edit, or Escape.
    clip: Option[Clip]
    clip_text: string
    marked: Option[Area]

    // The cell being typed into: its text and where the caret is. `entering` is a cell begun by
    // typing over it, where an arrow key finishes the entry and moves; a cell opened with F2 or a
    // double click moves its caret instead.
    editing: bool
    entering: bool
    text: string
    sel: Selection

    // Point mode: whether the reference just before the caret was written by pointing at cells, so
    // that the next click, drag or arrow replaces it rather than finishing the entry; where its text
    // starts; and the two ends pointed at, either of which has no row (`-1`) for whole columns or no
    // column for whole rows.
    pointing: bool
    ref_at: usize
    point_a: Ref
    point_b: Ref

    // Whether the edit is the formula bar's: typed there, with the bar keeping the keyboard while
    // cells are pointed at -- a press anywhere takes it from the bar for that one frame.
    bar_edit: bool

    // The line under the grid, and whether it is a complaint.
    message: string
    alert: bool

    // The column whose right edge is being dragged, or -1, where that column starts, and the width
    // the drag has made it so far -- given to the sheet, as one step, when the drag ends.
    resizing: int
    resize_x: int
    drag_w: int

    // Whether the press the grid is about to see was the second of a double click, and whether the
    // grid has the keyboard. Both are told by the window's events, which the grid cannot see.
    double: bool
    focused: bool

    // What the wheel has turned that has not yet added up to a whole row or column.
    rest_x: int
    rest_y: int

    // The name box, the formula bar, and which menu is open: the views that keep their own text.
    name: &Signal[string]
    bar: &Signal[string]
    open: &Signal[int]

    // Whether the About dialog is up. While it is, the grid takes no keys but the two that close it.
    about: &Signal[bool]

    // --- Reading ------------------------------------------------------------------------------------

    // The selected area.
    selection(self) -> Area = area_of(at(self.col, self.row), at(self.far_col, self.far_row))

    // The active cell's address, `B7`.
    address(self) -> string = at(self.col, self.row).text()

    // What the name box shows: the active cell, or the selection's size while one is being made.
    name_text(self) -> string = self.address()

    // What was typed into the active cell, and what the formula bar shows for it: the formula's
    // canonical text for a formula.
    input(self) -> string
        val a = self.address()

        self.sheet.formula(a) match
            Some(f) -> f
            None -> self.sheet.input(a)
    end input

    width(self, col: int) -> int =
        if col == self.resizing && self.drag_w > 0 then self.drag_w else self.sheet.width(col).unwrap_or(COL_W)

    // How many whole rows the cells have room for, at least one.
    rows_shown(self) -> int = (self.room_h / ROW_H).max(1)

    // Is there anything in this cell?
    filled(self, col: int, row: int) -> bool =
        inside(col, row) && !is_empty_value(self.sheet.value_at(col, row))

    // What the line under the grid says: a message if there is one, otherwise the count, sum and
    // average of a selection of more than one cell.
    status(self) -> string
        if self.message.len > 0 then return self.message
        if self.pointing then return "Point"

        val a = self.selection()

        if a.is_cell() then return ""

        val values = self.sheet.stored_in(a)
        var count = 0
        var numbers = 0
        var sum = 0.0

        for k in 0..<values.len()
            values[k] match
                Value.Empty -> ()
                Value.Number(x) ->
                    count += 1
                    numbers += 1
                    sum += x
                _ -> count += 1

        if count == 0 then return ""
        if numbers == 0 then return s"Count: ${count}"

        s"Average: ${general(sum / real(numbers))}    Count: ${count}    Sum: ${general(sum)}"
    end status

    // --- Moving -------------------------------------------------------------------------------------

    // Make a cell active and the selection that one cell, and bring it on screen.
    go(*self, col: int, row: int)
        self.col = col.clamp(0, MAX_COLS - 1)
        self.row = row.clamp(0, MAX_ROWS - 1)
        self.far_col = self.col
        self.far_row = self.row
        self.message = ""
        self.follow(self.col, self.row)
        self.sync()

    // Move the selection's far corner, leaving the active cell where it is, and bring it on screen
    // along the axes asked — not down to the last row for a whole column picked.
    extend(*self, col: int, row: int, across: bool = true, down: bool = true)
        self.far_col = col.clamp(0, MAX_COLS - 1)
        self.far_row = row.clamp(0, MAX_ROWS - 1)
        self.message = ""
        self.follow(if across then self.far_col else self.left, if down then self.far_row else self.top)
        self.sync()

    // An arrow, Tab or Enter: one step, or with shift the far corner one step.
    step(*self, dc: int, dr: int, stretch: bool)
        if stretch then self.extend(self.far_col + dc, self.far_row + dr)
        else self.go(self.col + dc, self.row + dr)

    // Ctrl and an arrow: to the edge of the block of filled cells, as every spreadsheet does — along
    // a run of filled cells to its last one, or across empty ones to the next filled one or the edge.
    leap(*self, dc: int, dr: int, stretch: bool)
        var c = if stretch then self.far_col else self.col
        var r = if stretch then self.far_row else self.row

        if self.filled(c, r) && self.filled(c + dc, r + dr)
            while self.filled(c + dc, r + dr)
                c += dc
                r += dr
        else
            loop
                if !inside(c + dc, r + dr) then break

                c += dc
                r += dr

                // Coming back from beyond everything stored, the walk starts at its edge.
                if dc < 0 && c > self.sheet.last_col then c = self.sheet.last_col.max(0)
                if dr < 0 && r > self.sheet.last_row then r = self.sheet.last_row.max(0)

                if self.filled(c, r) then break

                // Past everything stored, nothing more will be found: straight to the edge.
                if (dc > 0 && c > self.sheet.last_col) || (dr > 0 && r > self.sheet.last_row)
                    if dc > 0 then c = MAX_COLS - 1
                    if dr > 0 then r = MAX_ROWS - 1
                    break

        if stretch then self.extend(c, r) else self.go(c, r)
    end leap

    // Page Up and Page Down: a screenful, the grid moving with the active cell.
    page(*self, down: bool, stretch: bool)
        val n = if down then self.rows_shown() else -self.rows_shown()

        self.top = (self.top + n).clamp(0, MAX_ROWS - 1)

        if stretch then self.extend(self.far_col, self.far_row + n) else self.go(self.col, self.row + n)

    // Scroll so that a cell is wholly on screen.
    follow(*self, col: int, row: int)
        val n = self.rows_shown()

        if row < self.top then self.top = row
        elif row >= self.top + n then self.top = row - n + 1

        if col < self.left
            self.left = col
            return

        // The leftmost first column that still shows `col` whole.
        var first = col
        var used = self.width(col)

        while first > 0 && used + self.width(first - 1) <= self.room_w
            first -= 1
            used += self.width(first)

        if self.left < first then self.left = first
    end follow

    // The wheel or a trackpad turned, in points; positive moves the content down and right.
    wheel(*self, dx: int, dy: int)
        self.rest_y += dy
        self.rest_x += dx

        val rows = self.rest_y / ROW_H
        val cols = self.rest_x / (COL_W / 2)

        self.rest_y -= rows * ROW_H
        self.rest_x -= cols * (COL_W / 2)
        self.top = (self.top - rows).clamp(0, MAX_ROWS - 1)
        self.left = (self.left - cols).clamp(0, MAX_COLS - 1)

    // --- Picking with the pointer -------------------------------------------------------------------

    // A click on a cell, with shift to stretch the selection to it.
    // While a formula is being typed with the caret where a reference may go, it writes the cell's
    // reference instead, and with shift stretches the reference written to a range.
    click(*self, col: int, row: int, stretch: bool)
        if self.can_point() then return self.point_at(at(col, row), stretch)
        if self.editing && !self.commit() then return

        if stretch then self.extend(col, row) else self.go(col, row)

    // A drag across the cells, after the press that began it: in point mode, the range written.
    drag(*self, col: int, row: int)
        if self.pointing then self.point_at(at(col, row), true)
        elif self.far_col != col || self.far_row != row then self.extend(col, row)

    // A click on a column's letter: the whole column, its first cell active, the grid not scrolled
    // up or down. With shift, every column from the active one to it. In point mode, `C:C`.
    pick_column(*self, col: int, stretch: bool)
        if self.can_point() then return self.point_at(Ref(col, -1, false, false), stretch)
        if self.editing && !self.commit() then return

        if !stretch then self.col = col.clamp(0, MAX_COLS - 1)

        self.row = 0
        self.extend(col, MAX_ROWS - 1, down = false)

    // A drag along the column letters.
    drag_column(*self, col: int)
        if self.pointing then self.point_at(Ref(col, -1, false, false), true)
        elif self.far_col != col then self.extend(col, MAX_ROWS - 1, down = false)

    // A row's number, likewise.
    pick_row(*self, row: int, stretch: bool)
        if self.can_point() then return self.point_at(Ref(-1, row, false, false), stretch)
        if self.editing && !self.commit() then return

        if !stretch then self.row = row.clamp(0, MAX_ROWS - 1)

        self.col = 0
        self.extend(MAX_COLS - 1, row, across = false)

    drag_row(*self, row: int)
        if self.pointing then self.point_at(Ref(-1, row, false, false), true)
        elif self.far_row != row then self.extend(MAX_COLS - 1, row, across = false)

    select_all(*self)
        self.col = 0
        self.row = 0
        self.far_col = MAX_COLS - 1
        self.far_row = MAX_ROWS - 1
        self.sync()

    // A column's right edge dragged to make it `w` wide.
    set_width(*self, col: int, w: int) = self.sheet.set_width(col, w.max(MIN_COL_W))

    // The edge being dragged has reached `w`; the sheet hears of it when the drag ends.
    drag_width(*self, w: int) = self.drag_w = w.max(MIN_COL_W)

    end_resize(*self)
        if self.resizing >= 0 && self.drag_w > 0 then self.sheet.set_width(self.resizing, self.drag_w)

        self.resizing = -1
        self.drag_w = 0

    // Every selected column back to the standard width.
    standard_width(*self)
        val a = self.selection()

        self.sheet.reset_widths(a.col1, a.col2)

    // The name box: a cell or a range typed into it, selected.
    jump_to(*self, text: string) -> bool
        val a = parse_area(text) match
            Some(got) -> got
            None ->
                self.say(s"'${text}' is not a cell or a range", true)
                self.sync()
                return false

        self.go(a.col1, a.row1)
        self.extend(a.col2, a.row2)
        self.follow(a.col1, a.row1)
        true
    end jump_to

    // --- Typing -------------------------------------------------------------------------------------

    // A key, while the grid has the keyboard. Under the About dialog only Enter and Escape do
    // anything, and what they do is close it.
    key(*self, p: Press)
        if self.about.read()
            if p.key == Key.Enter || p.key == Key.Escape then self.close_about()
        elif self.editing
            self.edit_key(p)
        else
            self.move_key(p)

    private move_key(*self, p: Press)
        p.key match
            Key.Typed(t) -> self.begin(t, true)
            Key.Left -> if p.ctrl then self.leap(-1, 0, p.shift) else self.step(-1, 0, p.shift)
            Key.Right -> if p.ctrl then self.leap(1, 0, p.shift) else self.step(1, 0, p.shift)
            Key.Up -> if p.ctrl then self.leap(0, -1, p.shift) else self.step(0, -1, p.shift)
            Key.Down -> if p.ctrl then self.leap(0, 1, p.shift) else self.step(0, 1, p.shift)
            Key.Tab -> self.go(self.col + (if p.shift then -1 else 1), self.row)
            Key.Enter -> self.go(self.col, self.row + (if p.shift then -1 else 1))
            Key.Home ->
                val row = if p.ctrl then 0 else self.row

                if p.shift then self.extend(0, if p.ctrl then 0 else self.far_row) else self.go(0, row)
            Key.End ->
                if p.ctrl then self.go(self.sheet.last_col.max(0), self.sheet.last_row.max(0))
            Key.Delete -> self.clear()
            Key.Backspace -> self.clear()
            Key.PageUp -> self.page(false, p.shift)
            Key.PageDown -> self.page(true, p.shift)
            Key.Insert -> ()
            Key.F(_) -> ()
            Key.Escape ->
                self.message = ""
                self.clip = None
                self.marked = None
                self.sync()
    end move_key

    private edit_key(*self, p: Press)
        p.key match
            Key.Enter -> if self.commit() then self.go(self.col, self.row + (if p.shift then -1 else 1))
            Key.Tab -> if self.commit() then self.go(self.col + (if p.shift then -1 else 1), self.row)
            Key.Escape -> self.cancel()
            Key.Left -> self.arrow(p, -1, 0)
            Key.Right -> self.arrow(p, 1, 0)
            Key.Up -> self.arrow(p, 0, -1)
            Key.Down -> self.arrow(p, 0, 1)
            _ -> self.typed(p)

    // An arrow while typing: it finishes a cell typed over and moves, and moves the caret in a cell
    // opened to be changed. In a cell typed over with the caret where a reference may go, it points
    // instead: the reference written moves from the cell being typed into, and with shift stretches.
    private arrow(*self, p: Press, dc: int, dr: int)
        if !self.entering then self.typed(p)
        elif self.can_point() then self.point_step(dc, dr, p.shift)
        elif self.commit() then self.go(self.col + dc, self.row + dr)

    // Any key but an arrow in point mode ends it: what it types follows the reference rather than
    // replacing it.
    private typed(*self, p: Press)
        val e = apply(self.text, self.sel, p)

        self.text = e.text
        self.sel = e.sel
        self.pointing = false
        self.bar.set(e.text)

    // --- Pointing -----------------------------------------------------------------------------------
    //
    // **Excel's point mode.** While a formula is being typed, a click on a cell, a drag across cells,
    // a click on a column letter or a row number, or an arrow key in a cell typed over writes the
    // reference of what it points at into the formula at the caret, rather than finishing the entry.
    // It does so only where a reference may go: see `pointable`. Once a reference has been written,
    // the next pointing replaces it, until a key types something after it.

    // Can a reference be pointed into the text being typed, at the caret?
    can_point(self) -> bool = self.editing && (self.pointing || pointable(self.text, self.sel.lo()))

    // Point at `b`, or with `stretch` at the range from the end pointed at before to `b`.
    point_at(*self, b: Ref, stretch: bool)
        val a = if stretch && self.pointing && same_shape(self.point_a, b) then self.point_a else b

        if !self.pointing || a != self.point_a || b != self.point_b then self.write_point(a, b)

    // An arrow in point mode: the far end pointed at moves a step -- from the cell being typed into,
    // the first time -- and with `stretch` the near end stays.
    private point_step(*self, dc: int, dr: int, stretch: bool)
        val from = if self.pointing then self.point_b else at(self.col, self.row)
        val col = if from.col < 0 then self.left else from.col
        val row = if from.row < 0 then self.top else from.row
        val here = at(col, row)
        val b = at((col + dc).clamp(0, MAX_COLS - 1), (row + dr).clamp(0, MAX_ROWS - 1))
        val a = if !stretch then b elif self.pointing && same_shape(self.point_a, b) then self.point_a else here

        self.write_point(a, b)
    end point_step

    // Point at an area, as the name box would name it: whole columns and rows as such.
    point_area(*self, area: Area)
        val whole_cols = area.row1 == 0 && area.row2 == MAX_ROWS - 1
        val whole_rows = area.col1 == 0 && area.col2 == MAX_COLS - 1

        if whole_cols && !whole_rows
            self.write_point(Ref(area.col1, -1, false, false), Ref(area.col2, -1, false, false))
        elif whole_rows && !whole_cols
            self.write_point(Ref(-1, area.row1, false, false), Ref(-1, area.row2, false, false))
        else
            self.write_point(at(area.col1, area.row1), at(area.col2, area.row2))
    end point_area

    // The area pointed at, while in point mode.
    pointed(self) -> Option[Area] =
        if self.pointing then Some(area_of(self.point_a, self.point_b)) else None

    // Write the reference from `a` to `b` in place of the one pointed at before, or of the selected
    // text, and put the caret after it.
    private write_point(*self, a: Ref, b: Ref)
        val n = self.text.len
        val lo = (if self.pointing then self.ref_at else self.sel.lo()).min(n)
        val hi = (if self.pointing then self.sel.head else self.sel.hi()).min(n).max(lo)
        val t = reference_text(a, b)

        self.text = s"${self.text[0..<lo]}${t}${self.text[hi..<n]}"
        self.sel = Selection(lo + t.len, lo + t.len)
        self.ref_at = lo
        self.point_a = a
        self.point_b = b
        self.pointing = true
        self.message = ""
        self.bar.set(self.text)
        self.follow(if b.col < 0 then self.left else b.col, if b.row < 0 then self.top else b.row)
    end write_point

    // The formula bar has the keyboard, holding `text` with `sel` selected: the edit is the bar's, and
    // pointing at cells writes into it. Text or a caret changed in the bar since the last pointing
    // ends point mode, as a key typed in the cell does.
    from_bar(*self, text: string, sel: Selection)
        val n = text.len
        val s = Selection(sel.anchor.min(n), sel.head.min(n))

        self.bar_edit = true

        if !self.editing
            self.editing = true
            self.entering = false
            self.far_col = self.col
            self.far_row = self.row
            self.pointing = false
        elif text == self.text && s == self.sel
            return

        self.text = text
        self.sel = s
        self.pointing = false
    end from_bar

    // --- The About dialog ---------------------------------------------------------------------------

    show_about(*self) = self.about.set(true)

    close_about(*self) = self.about.set(false)

    // Start typing into the active cell with `text` in it, the caret at its end.
    begin(*self, text: string, entering: bool)
        self.editing = true
        self.entering = entering
        self.pointing = false
        self.bar_edit = false
        self.text = text
        self.sel = Selection(text.len, text.len)
        self.far_col = self.col
        self.far_row = self.row
        self.message = ""
        self.follow(self.col, self.row)
        self.bar.set(text)

    // F2, or a double click: change what is in the active cell.
    edit_existing(*self) = self.begin(self.input(), false)

    // F2 while typing switches between moving the caret and finishing the entry with an arrow.
    toggle_entering(*self) = self.entering = !self.entering

    // Put what was typed into the cell. A formula that does not read is refused, the cell stays open,
    // and the line under the grid says why.
    commit(*self) -> bool
        if !self.editing then return true

        self.sheet.set_at(self.col, self.row, self.text) match
            Ok(_) ->
                self.editing = false
                self.pointing = false
                self.message = ""
                self.alert = false
                self.edited()
                true
            Err(e) ->
                self.say(e, true)
                false
    end commit

    cancel(*self)
        self.editing = false
        self.pointing = false
        self.message = ""
        self.sync()

    // The formula bar's text, put into the active cell.
    commit_bar(*self, text: string) -> bool
        self.sheet.set_at(self.col, self.row, text) match
            Ok(_) ->
                self.editing = false
                self.pointing = false
                self.message = ""
                self.edited()
                true
            Err(e) ->
                self.say(e, true)
                false
    end commit_bar

    // Empty every selected cell.
    clear(*self)
        self.sheet.clear(self.selection())
        self.message = ""
        self.edited()

    // --- Editing ------------------------------------------------------------------------------------

    // Ctrl-Z: the last edit taken back.
    undo(*self)
        if self.sheet.undo()
            self.message = ""
            self.edited()
        else
            self.say("there is nothing to undo")

    // Ctrl-Y or Ctrl-Shift-Z: the last edit undone made again.
    redo(*self)
        if self.sheet.redo()
            self.message = ""
            self.edited()
        else
            self.say("there is nothing to redo")

    // Ctrl-C: the selection taken to be pasted, outlined, and answered as the text the system
    // clipboard is given -- what the cells show, tab-separated, for any other program.
    copy(*self) -> string = self.take(self.sheet.copy(self.selection()))

    // Ctrl-X: the selection taken to be moved by the next paste.
    cut(*self) -> string = self.take(self.sheet.cut(self.selection()))

    private take(*self, c: Clip) -> string
        self.clip = Some(c)
        self.clip_text = self.sheet.tsv(c.area)
        self.marked = Some(c.area)
        self.message = ""
        self.clip_text
    end take

    // Ctrl-V, given what the system clipboard holds. While that is still the text the last copy or
    // cut put there, the cells themselves are pasted, formulas and all; anything else came from
    // another program and is pasted as tab-separated inputs. A pasted cut moves its cells, and is
    // then used up.
    paste(*self, outside: string)
        val ours = self.clip match
            Some(c) -> if outside == self.clip_text || outside.len == 0 then Some(c) else None
            None -> None

        val done = ours match
            Some(c) -> self.sheet.paste(c, self.selection())
            None ->
                if outside.len == 0
                    self.say("there is nothing to paste")
                    return

                self.sheet.paste_text(outside, self.col, self.row)

        done match
            Ok(a) ->
                val was_cut = ours match
                    Some(c) -> c.cut
                    None -> false

                if was_cut then self.clip = None

                self.select(a)
                self.message = ""
                self.marked = if was_cut || ours.is_none() then None else self.marked
                self.sync()
            Err(e) -> self.say(e, true)
    end paste

    // Ctrl-D and Ctrl-R.
    fill_down(*self) = self.filled_by(self.sheet.fill_down(self.selection()))

    fill_right(*self) = self.filled_by(self.sheet.fill_right(self.selection()))

    private filled_by(*self, r: Result[Area, string])
        r match
            Ok(_) ->
                self.message = ""
                self.edited()
            Err(e) -> self.say(e, true)

    // Insert ▸ Row above and Column left: as many as are selected, before the selection.
    insert_rows(*self) = self.structural(self.sheet.insert_rows(self.selection().row1, self.selection().height()))

    insert_cols(*self) = self.structural(self.sheet.insert_cols(self.selection().col1, self.selection().width()))

    // Insert ▸ Delete row and Delete column: the selected rows or columns, closed up.
    delete_rows(*self) = self.structural(self.sheet.delete_rows(self.selection().row1, self.selection().height()))

    delete_cols(*self) = self.structural(self.sheet.delete_cols(self.selection().col1, self.selection().width()))

    private structural(*self, r: Result[unit, string])
        r match
            Ok(_) ->
                self.message = ""
                self.edited()
            Err(e) -> self.say(e, true)

    // An area selected, its first cell active.
    select(*self, a: Area)
        self.go(a.col1, a.row1)
        self.extend(a.col2, a.row2)
        self.follow(a.col1, a.row1)

    // After any edit the outline of a copy or a cut is gone, and a cut is no longer there to move,
    // as Excel has it: the cells it named may not be what they were.
    private edited(*self)
        self.marked = None

        val cut = self.clip match
            Some(c) -> c.cut
            None -> false

        if cut then self.clip = None

        self.sync()
    end edited

    // A fresh, empty sheet.
    renew(*self)
        self.sheet = sheet("Sheet1")
        self.clip = None
        self.marked = None
        self.editing = false
        self.pointing = false
        self.left = 0
        self.top = 0
        self.go(0, 0)

    // Something for the line under the grid.
    say(*self, text: string, alert: bool = false)
        self.message = text
        self.alert = alert

    // Tell the name box and the formula bar what the active cell is now.
    sync(*self)
        self.name.set(self.name_text())

        if !self.editing then self.bar.set(self.input())
end Model

// Is this a cell of the sheet at all?
inside(col: int, row: int) -> bool = col >= 0 && col < MAX_COLS && row >= 0 && row < MAX_ROWS

// A window's worth of state over an empty sheet.
model() -> &Model
    val m: &Model = Model(sheet("Sheet1"), 0, 0, 0, 0, 0, 0, 1000, 600, None, "", None, false, false, "",
                          Selection(0, 0), false, 0, at(0, 0), at(0, 0), false, "", false, -1, 0, 0, false,
                          false, 0, 0, signal("A1"), signal(""), signal(-1), signal(false))
    m
end model

// The example `--demo` opens: a quarter's household budget, totalled.
demo(m: &Model)
    val rows = [
        ["Household budget", "", "", "", ""],
        ["", "", "", "", ""],
        ["Item", "January", "February", "March", "Quarter"],
        ["Rent", "1200", "1200", "1200", "=SUM(B4:D4)"],
        ["Groceries", "412.5", "389.2", "430.75", "=SUM(B5:D5)"],
        ["Utilities", "145", "162.3", "138.9", "=SUM(B6:D6)"],
        ["Transport", "96", "104.5", "88", "=SUM(B7:D7)"],
        ["Going out", "120", "75", "160", "=SUM(B8:D8)"],
        ["Total", "=SUM(B4:B8)", "=SUM(C4:C8)", "=SUM(D4:D8)", "=SUM(E4:E8)"],
        ["", "", "", "", ""],
        ["Monthly average", "=E9/3", "", "", ""],
        ["Largest item", "=MAX(E4:E8)", "", "", ""],
        ["Rent share", "=ROUND(E4/E9*100,1)&\"%\"", "", "", ""],
        ["Verdict", "=IF(E9>5000,\"over budget\",\"within budget\")", "", "", ""],
    ]

    for r in 0..<rows.len
        for c in 0..<rows[r].len
            if rows[r][c].len > 0 then m.sheet.set_at(int(c), int(r), rows[r][c]).unwrap()

    m.set_width(0, 130)
    m.sheet.forget_history()
    m.go(4, 8)
end demo

// A `Value` that is empty.
private is_empty_value(v: Value) -> bool = v match
    Value.Empty -> true
    _ -> false

// What a reference may follow.
private const OPENERS: string = "=+-*/^&<>(,:"

// **May a reference be pointed into `text` at `caret`?** Excel's rule, made exact: the text is a
// formula (it starts with `=`), the caret is not inside quoted text, and the nearest character before
// the caret that is not a space is `=`, an operator (`+ - * / ^ & < >`, which covers `<=`, `>=` and
// `<>`), `(`, `,` or `:`. So after `=SUM(` or `=A1+` a click points, and after `=A1`, `=12` or
// `=SUM(A1)` it finishes the entry as it always has.
pointable(text: string, caret: usize) -> bool
    val b = text.bytes

    if text.len == 0 || b[0] != u8('=') || caret > text.len then return false

    var quoted = false

    for k in 0..<caret
        if b[k] == u8('"') then quoted = !quoted

    if quoted then return false

    var k = caret

    while k > 0 && b[k - 1] == u8(' ')
        k -= 1

    k > 0 && OPENERS.contains(text[k - 1..<k])
end pointable

// Are the two ends both cells, both whole columns, or both whole rows?
private same_shape(a: Ref, b: Ref) -> bool = (a.col < 0) == (b.col < 0) && (a.row < 0) == (b.row < 0)

// The text of the reference from `a` to `b`: one cell `B4`, a range `B4:D8` written from its top left
// corner, whole columns `C:E` or whole rows `5:7`.
reference_text(a: Ref, b: Ref) -> string
    val first = at(a.col.min(b.col), a.row.min(b.row))
    val last = at(a.col.max(b.col), a.row.max(b.row))

    if first == last && first.col >= 0 && first.row >= 0 then first.text() else s"${first.text()}:${last.text()}"

// A reference in a formula's text: the bytes it takes, and the cells it names.
struct Span
    start: usize
    stop: usize
    area: Area

// **The references in a formula as typed**, for colouring each one and outlining what it names, as
// Excel and LibreOffice do. A name followed by `(` is a function, quoted text is text, and a
// reference into another sheet (`Sheet2!A1`) is not one of this sheet's cells.
references(text: string) -> Buf[Span]
    val b = text.bytes
    var found: Buf[Span] = buf()
    var quoted = false
    var k: usize = 0

    while k < text.len
        if b[k] == u8('"')
            quoted = !quoted
            k += 1
        elif quoted || !ref_byte(b[k])
            k += 1
        else
            var e = k

            while e < text.len && (ref_byte(b[e]) || b[e] == u8(':'))
                e += 1

            val called = e < text.len && (b[e] == u8('(') || b[e] == u8('!'))
            val sheet = k > 0 && b[k - 1] == u8('!')

            if !called && !sheet
                parse_area(text[k..<e]) match
                    Some(a) -> found.push(Span(k, e, a))
                    None -> ()

            // Past the whole word, so that the `5` of `1.5` or `1E5` is never read as a row.
            while e < text.len && (ref_byte(b[e]) || b[e] == u8('.') || b[e] == u8('_'))
                e += 1

            k = e

    found
end references

// A byte that may be part of a reference: a letter, a digit, or `$`.
private ref_byte(c: u8) -> bool =
    (c >= u8('A') && c <= u8('Z')) || (c >= u8('a') && c <= u8('z')) || (c >= u8('0') && c <= u8('9')) ||
        c == u8('$')
