// abax, the application: a sheet in a window, with a menu, a name box, a formula bar and the grid.
//
//     abax-app [--demo] [--cell <address>=<input>]... [--cut <range>] [--select <range>]
//              [--edit <address>=<text> [--point <range>]] [--about] [--shot <out.png>]
//
// `--demo` opens a small budget to look at. `--cell` puts something into a cell, as typing it would,
// `--cut` cuts a range, as Ctrl-X would but leaving the system clipboard alone, and `--select`
// selects a cell or a range. `--edit` leaves a cell being typed into, `--point` points at a range
// from it as a click and a drag would, and `--about` opens the About dialog -- so `--shot`, which
// draws one frame with no window and writes it to a PNG, draws a picture a machine can check.

import sh.sysl.ui.{Rect, render, pluto_canvas, fraction}
import sh.sysl.ui_sdl.{app, run, system_font, stop}
import sh.sysl.sdl3.{Event, EventKind, KMOD_GUI, KMOD_CTRL, KMOD_SHIFT, SCANCODE_N, SCANCODE_O, SCANCODE_S,
                     SCANCODE_Q, SCANCODE_A, SCANCODE_Z, SCANCODE_Y, SCANCODE_X, SCANCODE_C, SCANCODE_V,
                     SCANCODE_D, SCANCODE_R, SCANCODE_PAGEUP, SCANCODE_PAGEDOWN, SCANCODE_F2,
                     clipboard_text, set_clipboard_text}
import sh.sysl.plutovg
import sh.sysl.abax.parse_area
import sysl.text.Search

const WIDTH: int = 1100
const HEIGHT: int = 720

const USAGE: string = "usage: abax-app [--demo] [--cell <address>=<input>]... [--cut <range>] [--select <range>] [--edit <address>=<text> [--point <range>]] [--about] [--shot <out.png>]"

main(args: []string) -> Result[unit, string]
    val m = model()
    var shot = ""
    var picked = ""
    var cutting = ""
    var editing = ""
    var pointing = ""
    var i: usize = 1

    while i < args.len
        val a = args[i]

        if a == "--shot" && i + 1 < args.len
            shot = args[i + 1]
            i += 2
        elif a == "--demo"
            demo(m)
            i += 1
        elif a == "--cell" && i + 1 < args.len
            val spec = args[i + 1]
            val eq = spec.index_of("=").ok_or(s"--cell takes <address>=<input>, not '${spec}'")?

            m.sheet.set(spec[0..<eq], spec[eq + 1..<spec.len]).map_err(e -> s"--cell ${spec}: ${e}")?
            i += 2
        elif a == "--select" && i + 1 < args.len
            picked = args[i + 1]
            i += 2
        elif a == "--cut" && i + 1 < args.len
            cutting = args[i + 1]
            i += 2
        elif a == "--edit" && i + 1 < args.len
            editing = args[i + 1]
            i += 2
        elif a == "--point" && i + 1 < args.len
            pointing = args[i + 1]
            i += 2
        elif a == "--about"
            m.show_about()
            i += 1
        else
            return Err(s"${USAGE} ('${a}' is not one of these)")

    // A range cut, so that a shot shows its outline; the selection then goes where `--select` says.
    if cutting.len > 0
        if !m.jump_to(cutting) then return Err(m.message)

        val _ = m.cut()

    if picked.len > 0 && !m.jump_to(picked) then return Err(m.message)

    // A cell left being typed into, and a range pointed at from it.
    if editing.len > 0
        val eq = editing.index_of("=").ok_or(s"--edit takes <address>=<text>, not '${editing}'")?

        if !m.jump_to(editing[0..<eq]) then return Err(m.message)

        m.begin(editing[eq + 1..<editing.len], true)

    if pointing.len > 0
        val area = parse_area(pointing).ok_or(s"--point takes a cell or a range, not '${pointing}'")?

        if !m.can_point() then return Err("--point needs --edit with a formula a reference may follow")

        m.point_area(area)

    m.sync()

    if shot == "" then return run(app("abax", () -> screen(m), () -> GROUND, WIDTH, HEIGHT,
                                      on_event = e -> shortcut(m, e)))

    val font = system_font()

    if font == "" then return Err("no font this program knows about is on this machine")

    val surf = plutovg.surface(WIDTH, HEIGHT).expect("a drawing surface")
    val vg = plutovg.canvas(surf).expect("a drawing canvas")
    val face = plutovg.font(font).expect(s"the font at ${font} opened")
    var c = pluto_canvas(vg, face, 15.0)

    surf.clear(fraction(GROUND, 16), fraction(GROUND, 8), fraction(GROUND, 0))
    render(screen(m), &c, Rect(0, 0, WIDTH, HEIGHT))

    if !surf.write_png(shot) then return Err(s"${shot} could not be written")

    print(s"wrote ${shot}: ${m.address()} ${m.status()}")
    Ok(())
end main

// The keys the grid cannot hear from the toolkit — the menu shortcuts, Page Up and Page Down, F2 —
// and the double click, which the toolkit reports as a single tap.
private shortcut(m: &Model, e: Event) -> bool
    val kind = e.kind()

    if kind == EventKind.MouseButtonDown
        m.double = e.mouse_clicks() >= 2u8
        return false

    // Under the About dialog no shortcut works: its keys go to the grid, which only closes it.
    if kind != EventKind.KeyDown || m.about.read() then return false

    val key = e.key_scancode()
    val mods = e.key_mod()
    val command = (mods & (KMOD_GUI | KMOD_CTRL)) != 0u16
    val shift = (mods & KMOD_SHIFT) != 0u16

    if command
        // The editing keys are the grid's only while no cell is being typed into: there they belong
        // to the text.
        val grid = m.focused && !m.editing

        if key == SCANCODE_N then m.renew()
        elif key == SCANCODE_O then not_yet(m, "Opening")
        elif key == SCANCODE_S then not_yet(m, "Saving")
        elif key == SCANCODE_Q then stop()
        elif !grid then return false
        elif key == SCANCODE_A then m.select_all()
        elif key == SCANCODE_Z then if shift then m.redo() else m.undo()
        elif key == SCANCODE_Y then m.redo()
        elif key == SCANCODE_X then cut_out(m)
        elif key == SCANCODE_C then copy_out(m)
        elif key == SCANCODE_V then paste_in(m)
        elif key == SCANCODE_D then m.fill_down()
        elif key == SCANCODE_R then m.fill_right()
        else return false

        return true

    if !m.focused then return false

    if key == SCANCODE_F2
        if m.editing then m.toggle_entering() else m.edit_existing()
    elif key == SCANCODE_PAGEUP || key == SCANCODE_PAGEDOWN
        if m.editing && !m.commit() then return true

        m.page(key == SCANCODE_PAGEDOWN, shift)
    else
        return false

    true
end shortcut

// Copy, cut and paste through the system clipboard, which carries what the cells show as
// tab-separated text, for other programs; the cells themselves stay in the model, for abax.
copy_out(m: &Model)
    val _ = set_clipboard_text(m.copy())

cut_out(m: &Model)
    val _ = set_clipboard_text(m.cut())

paste_in(m: &Model) = m.paste(clipboard_text())
